---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimesSubstackEmbed from '../components/TimesSubstackEmbed.astro';

const QUESTIONS = [
  'I watch short-form videos for 30+ minutes without noticing',
  'I check my phone even when there\'s no notification',
  'I feel uneasy without my phone nearby during meals or conversations',
  "I'm on my phone right up until I fall asleep",
  'Regular-speed video feels too slow — I speed up or skip ahead',
  'I always open my phone during any wait (traffic light, checkout, elevator)',
  'I open another tab or app in the middle of working',
  'Quiet time or boredom feels uncomfortable',
  "I jump between pieces of content without finishing any of them",
  'I keep checking for reactions (likes, replies) on social media',
  "I've tried to cut down my phone use and failed",
  'I find myself following high-stimulation content (controversy, gossip, extreme news)',
  'Imagining a day without my phone makes me anxious',
];
---

<BaseLayout
  title="Dopamine Debt Score"
  description="A 13-question self-check, informed by public research including the SAS-SV, that scores your current stimulation habits from 0 to 100."
>
  <div class="container">
    <section class="check-section" id="debt-check">
      <p class="section-label">Dopamine Debt Score</p>
      <div class="check-card">
        <!-- Quiz -->
        <div id="debt-quiz">
          <div class="check-intro">
            <h1 class="check-heading">
              Turn stimulation borrowing<br /><span class="check-heading-accent">into a number</span>
            </h1>
            <p class="check-sub">Answer 13 questions (about 2 minutes)</p>
            <a href="/ja/dopamine-debt/" class="glossary-lang-switch">日本語版 →</a>
          </div>

          <div class="check-questions">
            {QUESTIONS.map((q, i) => (
              <div class="check-q">
                <p class="check-q-text">
                  <span class="check-q-num">Q{i + 1}</span>{q}
                </p>
                <div class="check-q-btns">
                  <button class="check-btn" data-q={i} data-val="0">Rarely</button>
                  <button class="check-btn" data-q={i} data-val="1">Sometimes</button>
                  <button class="check-btn" data-q={i} data-val="3">Often</button>
                </div>
              </div>
            ))}
          </div>

          <button class="btn check-submit" id="debt-submit" disabled aria-disabled="true">
            See your result →
          </button>
        </div>

        <!-- Result (hidden until quiz completes) -->
        <div id="debt-result" hidden>
          <div class="fatigue-score">
            <span class="fatigue-score-label">Dopamine Debt Score</span>
            <span class="fatigue-score-num" id="debt-score-num">--</span>
            <span class="fatigue-score-max">/ 100</span>
          </div>
          <p class="fatigue-delta" id="debt-delta" hidden></p>

          <div id="debt-band-low" hidden>
            <p class="check-badge check-badge--low">Low Debt</p>
            <h2 class="check-result-h">
              Your stimulation intake<br />looks healthy right now
            </h2>
            <p class="check-result-body">
              There's little sign of borrowing intensity to get through the day. Your dopamine
              receptors still respond to small rewards, which means this margin — this room to
              feel satisfied by ordinary things — is intact. Protecting it is what keeps focus
              possible.
            </p>
            <a href="/posts/totonou-what-your-brain-needs" class="check-rec-link">
              <span class="check-rec-label">Read first</span>
              <span class="check-rec-title">Totonou: The Japanese Word for What Your Brain Has Been Missing →</span>
            </a>
            <a href="/posts/hare-and-ke-dopamine-reset" class="check-rec-link">
              <span class="check-rec-label">Read next</span>
              <span class="check-rec-title">Hare and Ke: The 2,000-Year Japanese Blueprint for Dopamine Reset →</span>
            </a>
          </div>

          <div id="debt-band-mid" hidden>
            <p class="check-badge check-badge--low">Accumulating</p>
            <h2 class="check-result-h">
              You're starting to borrow<br />stimulation, a little at a time
            </h2>
            <p class="check-result-body">
              Dependence on strong stimulation hasn't hardened into a habit yet, but the reflex
              to reach for your phone to fill boredom or silence is starting to show. This is
              the cheapest point to intervene.
            </p>
            <a href="/posts/why-you-cant-put-down-your-phone" class="check-rec-link">
              <span class="check-rec-label">Read first</span>
              <span class="check-rec-title">Why You Can't Put Down Your Phone →</span>
            </a>
            <a href="/posts/why-you-cant-focus-anymore" class="check-rec-link">
              <span class="check-rec-label">Read next</span>
              <span class="check-rec-title">Why You Can't Focus Anymore →</span>
            </a>
          </div>

          <div id="debt-band-high" hidden>
            <p class="check-badge check-badge--high">Overdrawn</p>
            <h2 class="check-result-h">
              Your reward system now<br />expects high stimulation
            </h2>
            <p class="check-result-body">
              Multiple patterns are present, consistent with your brain's reward prediction
              shifting toward high-intensity input. Quiet time and ordinary, unstimulating
              tasks start to feel more uncomfortable than they actually are. A deliberate
              period of lower stimulation is what resets the baseline.
            </p>
            <a href="/posts/why-you-cant-put-down-your-phone" class="check-rec-link">
              <span class="check-rec-label">Read first</span>
              <span class="check-rec-title">Why You Can't Put Down Your Phone →</span>
            </a>
            <a href="/posts/hare-and-ke-dopamine-reset" class="check-rec-link">
              <span class="check-rec-label">Read next</span>
              <span class="check-rec-title">Hare and Ke: The 2,000-Year Japanese Blueprint for Dopamine Reset →</span>
            </a>
            <a href="/posts/why-you-cant-focus-anymore" class="check-rec-link">
              <span class="check-rec-label">Also read</span>
              <span class="check-rec-title">Why You Can't Focus Anymore →</span>
            </a>
          </div>

          <div id="debt-band-critical" hidden>
            <p class="check-badge check-badge--high">Critical</p>
            <h2 class="check-result-h">
              Borrowing has<br />become the default
            </h2>
            <p class="check-result-body">
              Nearly every item applies — this is a critical level of stimulation dependence.
              This isn't a medical diagnosis, but a structured digital detox is worth starting:
              notifications off, screen time made visible, and quiet time deliberately protected.
            </p>
            <a href="/posts/hare-and-ke-dopamine-reset" class="check-rec-link">
              <span class="check-rec-label">Read first</span>
              <span class="check-rec-title">Hare and Ke: The 2,000-Year Japanese Blueprint for Dopamine Reset →</span>
            </a>
            <a href="/posts/why-you-cant-put-down-your-phone" class="check-rec-link">
              <span class="check-rec-label">Read next</span>
              <span class="check-rec-title">Why You Can't Put Down Your Phone →</span>
            </a>
          </div>

          <a href="/protocols" class="check-rec-link" id="debt-protocols-link">
            <span class="check-rec-label">Take action</span>
            <span class="check-rec-title">See the full protocols list →</span>
          </a>

          <div class="fatigue-trend" id="debt-trend" hidden>
            <p class="check-cta-label">Measurement history</p>
            <div class="fatigue-trend-bars" id="debt-trend-bars"></div>
          </div>

          <div class="times-substack-crosslink">
            <p>Re-measure every Sunday — alongside The Dopamine Times (JP).</p>
            <a href="/times/" class="fatigue-times-link" id="debt-times-link">See The Dopamine Times →</a>
            <TimesSubstackEmbed />
          </div>

          <div class="check-share">
            <a id="debt-share-btn" class="check-share-btn" href="#" target="_blank" rel="noopener noreferrer"
               aria-label="Share on X (Twitter)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              Share on X
            </a>
            <button class="check-retry" id="debt-retry">
              ← Take it again
            </button>
          </div>

          <p class="check-other-link">
            Other measurement: <a href="/fatigue/">check your Fatigue Coefficient →</a>
          </p>

          <p class="fatigue-evidence">
            This check is an editorial behavioral instrument written by the Dopamine Lab TV team, informed by
            public research including the Smartphone Addiction Scale — Short Version (SAS-SV, Kwon et al., 2013).
            It is not a validated clinical scale, and not a medical diagnosis.
            <a href="https://pubmed.ncbi.nlm.nih.gov/24391787/" target="_blank" rel="noopener noreferrer">Source: SAS-SV validation study</a>
          </p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
  (function () {
    var QUESTION_COUNT = 13;
    var MAX_SCORE = 39;
    var HISTORY_KEY = 'dlt_dopamine_debt_history';
    var MAX_HISTORY = 12;

    var answers = new Array(QUESTION_COUNT).fill(null);
    var started = false;
    var submitBtn = document.getElementById('debt-submit');
    var retryBtn = document.getElementById('debt-retry');
    var shareBtnEl = document.getElementById('debt-share-btn');
    var quizEl = document.getElementById('debt-quiz');
    var resultEl = document.getElementById('debt-result');
    var scoreNumEl = document.getElementById('debt-score-num');
    var deltaEl = document.getElementById('debt-delta');
    var trendEl = document.getElementById('debt-trend');
    var trendBarsEl = document.getElementById('debt-trend-bars');
    var bandLow = document.getElementById('debt-band-low');
    var bandMid = document.getElementById('debt-band-mid');
    var bandHigh = document.getElementById('debt-band-high');
    var bandCritical = document.getElementById('debt-band-critical');

    if (!submitBtn) return;

    function ga(event, params) {
      if (typeof window.gtag === 'function') window.gtag('event', event, params || {});
    }

    function todayStr() {
      var d = new Date();
      var m = String(d.getMonth() + 1).padStart(2, '0');
      var day = String(d.getDate()).padStart(2, '0');
      return d.getFullYear() + '-' + m + '-' + day;
    }

    function shortDate(d) {
      var parts = d.split('-');
      return parseInt(parts[1], 10) + '/' + parseInt(parts[2], 10);
    }

    function loadHistory() {
      try {
        var raw = localStorage.getItem(HISTORY_KEY);
        var arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr : [];
      } catch { return []; }
    }

    function saveHistory(score) {
      var history = loadHistory();
      var today = todayStr();
      var previous = null;
      for (var i = history.length - 1; i >= 0; i--) {
        if (history[i].d !== today) { previous = history[i]; break; }
      }

      var existingIdx = history.findIndex(function (h) { return h.d === today; });
      if (existingIdx >= 0) history[existingIdx] = { d: today, c: score };
      else history.push({ d: today, c: score });

      history.sort(function (a, b) { return a.d < b.d ? -1 : a.d > b.d ? 1 : 0; });
      if (history.length > MAX_HISTORY) history = history.slice(history.length - MAX_HISTORY);

      try { localStorage.setItem(HISTORY_KEY, JSON.stringify(history)); } catch { /* noop */ }
      return { history: history, previous: previous };
    }

    function renderTrend(history) {
      if (!trendEl || !trendBarsEl || history.length < 2) return;
      trendBarsEl.innerHTML = '';
      var today = todayStr();
      history.forEach(function (entry) {
        var bar = document.createElement('div');
        bar.className = 'fatigue-trend-bar' + (entry.d === today ? ' fatigue-trend-bar--today' : '');
        var fill = document.createElement('div');
        fill.className = 'fatigue-trend-bar-fill';
        fill.style.height = Math.max(4, entry.c) + '%';
        var label = document.createElement('span');
        label.className = 'fatigue-trend-bar-label';
        label.textContent = shortDate(entry.d);
        bar.appendChild(fill);
        bar.appendChild(label);
        trendBarsEl.appendChild(bar);
      });
      trendEl.hidden = false;
    }

    document.querySelectorAll('#debt-quiz .check-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var q = parseInt(btn.dataset.q, 10);
        answers[q] = parseInt(btn.dataset.val, 10);

        if (!started) { started = true; ga('quiz_start', { quiz_id: 'dopamine_debt_en' }); }

        btn.closest('.check-q').querySelectorAll('.check-btn').forEach(function (b) {
          b.classList.remove('check-btn--active');
        });
        btn.classList.add('check-btn--active');

        if (answers.every(function (a) { return a !== null; })) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-disabled');
        }
      });
    });

    submitBtn.addEventListener('click', function () {
      var total = answers.reduce(function (sum, a) { return sum + a; }, 0);
      var score = Math.round((total / MAX_SCORE) * 100);
      var band = score <= 25 ? 'low' : score <= 50 ? 'mid' : score <= 75 ? 'high' : 'critical';

      ga('quiz_complete', { quiz_id: 'dopamine_debt_en', score: score, band: band });

      var saved = saveHistory(score);

      quizEl.hidden = true;
      resultEl.hidden = false;
      scoreNumEl.textContent = String(score);
      bandLow.hidden = band !== 'low';
      bandMid.hidden = band !== 'mid';
      bandHigh.hidden = band !== 'high';
      bandCritical.hidden = band !== 'critical';

      if (saved.previous) {
        var delta = score - saved.previous.c;
        var sign = delta > 0 ? '+' + delta : String(delta);
        deltaEl.textContent = 'Last time (' + shortDate(saved.previous.d) + '): ' + saved.previous.c + ' → Today: ' + score + ' (' + sign + ')';
        deltaEl.hidden = false;
      }

      renderTrend(saved.history);

      var bandLabel = band === 'low' ? 'Low Debt' : band === 'mid' ? 'Accumulating' : band === 'high' ? 'Overdrawn' : 'Critical';
      var shareText = 'I checked my Dopamine Debt Score.\nResult: ' + bandLabel + ' (' + score + '/100)\n→ 2-minute check\nhttps://dopaminelabtv.com/dopamine-debt/\n#dopamine #neuroscience';
      if (shareBtnEl) shareBtnEl.href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText);

      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    if (shareBtnEl) {
      shareBtnEl.addEventListener('click', function () {
        ga('cta_click', { quiz_id: 'dopamine_debt_en', cta_target: 'x_share' });
      });
    }

    document.querySelectorAll('.check-rec-link').forEach(function (link) {
      link.addEventListener('click', function () {
        ga('quiz_rec_click', { quiz_id: 'dopamine_debt_en', link_url: link.href });
      });
    });

    var timesLink = document.getElementById('debt-times-link');
    if (timesLink) {
      timesLink.addEventListener('click', function () {
        ga('cta_click', { quiz_id: 'dopamine_debt_en', cta_target: timesLink.href });
      });
    }

    retryBtn.addEventListener('click', function () {
      answers = new Array(QUESTION_COUNT).fill(null);
      started = false;
      document.querySelectorAll('#debt-quiz .check-btn').forEach(function (b) { b.classList.remove('check-btn--active'); });
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-disabled', 'true');
      quizEl.hidden = false;
      resultEl.hidden = true;
      deltaEl.hidden = true;
      trendEl.hidden = true;
      bandLow.hidden = true;
      bandMid.hidden = true;
      bandHigh.hidden = true;
      bandCritical.hidden = true;
    });
  })();
  </script>
</BaseLayout>
