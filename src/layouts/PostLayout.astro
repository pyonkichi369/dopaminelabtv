---
import BaseLayout from './BaseLayout.astro';
import ShareBlock from '../components/ShareBlock.astro';
import RelatedProduct from '../components/RelatedProduct.astro';
import RelatedVideo from '../components/RelatedVideo.astro';
import { getSeriesForSlug, getSeriesIndex } from '../data/series';
import { getAlternatePostSlug } from '../data/post-pairs';
import { matchProduct } from '../data/products';
import { SHORTS } from '../data/shorts';

const { frontmatter, lang = 'en', ogImage } = Astro.props;
const sources: { name: string; url?: string }[] = frontmatter.sources ?? [];
const tldr: string[] = frontmatter.tldr ?? [];

const isJa = lang === 'ja';
const dateStr = new Date(frontmatter.date).toLocaleDateString(
  isJa ? 'ja-JP' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric' }
);

const tags: string[] = frontmatter.tags ?? [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Share
const shareHashtags = isJa ? '#ドーパミン #脳科学 #集中力' : '#dopamine #neuroscience #focus';
const shareText = isJa
  ? `「${frontmatter.title}」\n${shareHashtags}\n${canonicalURL}`
  : `"${frontmatter.title}" — The science of staying human.\n${shareHashtags}\n${canonicalURL}`;

function tagHref(t: string) {
  return isJa ? `/ja/tags/${t}` : `/tags/${t.toLowerCase().replace(/\s+/g, '-')}`;
}

// Breadcrumb
const homeLabel = isJa ? 'ホーム' : 'Home';
const postsLabel = isJa ? '記事' : 'Posts';
const homeURL = isJa ? `${Astro.site}ja/` : `${Astro.site}`;
const postsURL = isJa ? `${Astro.site}ja/posts/` : `${Astro.site}posts/`;
const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: homeURL },
    { '@type': 'ListItem', position: 2, name: postsLabel, item: postsURL },
    { '@type': 'ListItem', position: 3, name: frontmatter.title, item: canonicalURL.toString() },
  ],
};

// FAQPage schema — from faqItems frontmatter [{q, a}] or tldr array as answers
type FaqItem = { q: string; a: string };
const faqItems: FaqItem[] = frontmatter.faqItems ?? [];
const faqLD = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;

// Series
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';

// hreflang — translated counterpart uses a different slug, so the mirrored-path
// derivation can't find it; the pair table supplies the real alternate path.
const alternateSlug = getAlternatePostSlug(currentSlug, lang as 'en' | 'ja');
const alternatePath = alternateSlug
  ? (isJa ? `/posts/${alternateSlug}/` : `/ja/posts/${alternateSlug}/`)
  : undefined;
const seriesInfo = getSeriesForSlug(currentSlug, lang as 'en' | 'ja');
const seriesIndex = seriesInfo ? getSeriesIndex(seriesInfo, currentSlug, lang as 'en' | 'ja') : -1;

// Reciprocal video link — this article gets a "watch the video" callout only
// when a Short in src/data/shorts.ts is explicitly matched to this slug.
const hasMatchingShort = SHORTS.some(s =>
  (lang === 'ja' ? s.article_ja : s.article_en) === currentSlug
);

// Related posts
const allPosts = await Astro.glob('../content/posts/**/*.md');
const mapPost = (p: any) => {
  const postSlug = p.file.split('/').pop()!.replace('.md', '');
  return {
    url: lang === 'ja' ? `/ja/posts/${postSlug}` : `/posts/${postSlug}`,
    title: p.frontmatter.title as string,
    excerpt: p.frontmatter.excerpt as string,
    tags: (p.frontmatter.tags ?? []) as string[],
    readTime: p.frontmatter.readTime as number | undefined,
  };
};
const sameLang = (p: any) => {
  const parts = p.file.split('/');
  return parts[parts.length - 2] === lang && parts[parts.length - 1].replace('.md', '') !== currentSlug;
};
const related = allPosts
  .filter(p => sameLang(p) && p.frontmatter.tags?.some((t: string) => tags.includes(t)))
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3)
  .map(mapPost);
const relatedFallback = related.length > 0 ? [] : allPosts
  .filter(sameLang)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 2)
  .map(mapPost);
const displayRelated = related.length > 0 ? related : relatedFallback;

// Research-contextual product slot — matched by tag/title keyword overlap.
// Renders nothing when no product is topically relevant (see data/products.ts).
const matchedProduct = matchProduct(tags, frontmatter.title);
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.excerpt}
  ogImage={ogImage}
  lang={lang}
  hreflang={!!alternatePath}
  alternate={alternatePath}
  article={{
    publishedTime: frontmatter.date,
    updatedDate: frontmatter.updatedDate,
    wordCount: frontmatter.wordCount ?? (frontmatter.readTime ? frontmatter.readTime * 200 : undefined),
    tags,
    sources,
  }}
>
  <div class="reading-progress" id="reading-progress" role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={0}></div>

  <div class="container">
    <!-- Series banner -->
    {seriesInfo && (
      <a
        href={isJa ? `/ja/series/${seriesInfo.id}` : `/series/${seriesInfo.id}`}
        class="series-banner"
        aria-label={isJa ? `シリーズ: ${seriesInfo.titleJa}` : `Series: ${seriesInfo.title}`}
      >
        <span class="series-banner-label">{isJa ? 'シリーズ' : 'Series'}</span>
        <span class="series-banner-title">{isJa ? seriesInfo.titleJa : seriesInfo.title}</span>
        <span class="series-banner-count">
          {isJa
            ? `${seriesIndex + 1} / ${seriesInfo.slugs.ja.length}本`
            : `Part ${seriesIndex + 1} of ${seriesInfo.slugs.en.length}`}
        </span>
        <span class="series-banner-arrow">→</span>
      </a>
    )}

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={isJa ? '/ja/' : '/'}>{homeLabel}</a>
      <span aria-hidden="true">›</span>
      <a href={isJa ? '/ja/posts' : '/posts'}>{postsLabel}</a>
      <span aria-hidden="true">›</span>
      <span class="breadcrumb-current" aria-current="page">{frontmatter.title}</span>
    </nav>

    <div class="article-header">
      <div class="post-tags">
        {tags.map(t => <a href={tagHref(t)} class="tag">{t}</a>)}
      </div>
      <h1>{frontmatter.title}</h1>
      <div class="post-meta">
        <span class="date">{dateStr}</span>
        {frontmatter.readTime && (
          <span class="read-time">{frontmatter.readTime}{isJa ? ' 分' : ' min read'}</span>
        )}
      </div>
    </div>

    <!-- TL;DR -->
    {tldr.length > 0 && (
      <div class="tldr-box" role="note" aria-label={isJa ? 'この記事のポイント' : 'Key takeaways'}>
        <p class="tldr-label">{isJa ? 'この記事のポイント' : 'TL;DR'}</p>
        <ul class="tldr-list">
          {tldr.map(point => (
            <li class="tldr-item" style={isJa ? 'font-family: var(--font-jp)' : ''}>{point}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- ToC — JS-populated, hidden until headings found -->
    <nav class="toc" id="toc" style="display:none" aria-label={isJa ? '目次' : 'Table of contents'}>
      <p class="toc-label">{isJa ? '目次' : 'Contents'}</p>
      <ol class="toc-list" id="toc-list"></ol>
    </nav>

    <div class="article-body" id="article-body">
      <slot />

      {hasMatchingShort && <RelatedVideo lang={lang as 'en' | 'ja'} />}

      <div class="cta-block">
        <p>{isJa ? 'あなたの脳は今、どの状態ですか？' : 'What state is your brain in right now?'}</p>
        <div class="cta-block-btns">
          <a class="btn" href={isJa ? '/ja/#check' : '/#check'}>
            {isJa ? '3分でチェックする →' : 'Check in 3 minutes →'}
          </a>
          {isJa && frontmatter.noteUrl && (
            <a class="btn btn--note" href={frontmatter.noteUrl} target="_blank" rel="noopener noreferrer">
              {frontmatter.notePrice ? `有料版を読む（¥${frontmatter.notePrice}）→` : 'noteで深掘りする →'}
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Sources -->
    {sources.length > 0 && (
      <div class="article-sources">
        <p class="article-sources-label">{isJa ? '参考文献' : 'Sources'}</p>
        <ol class="article-sources-list">
          {sources.map(s => (
            <li class="article-source-item">
              {s.url ? (
                <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
              ) : (
                <span>{s.name}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    )}

    <!-- Share -->
    <div class="article-share">
      <p class="article-share-label">{isJa ? 'この記事をシェアする' : 'Share this article'}</p>
      <ShareBlock
        url={canonicalURL.toString()}
        shareText={shareText}
        lang={lang as 'ja' | 'en'}
        gaContext={`post_${currentSlug}`}
        title={frontmatter.title}
      />
    </div>

    <!-- Related posts -->
    {displayRelated.length > 0 && (
      <section class="related-posts">
        <p class="section-label">{isJa ? (related.length > 0 ? '関連記事' : '最新記事') : (related.length > 0 ? 'Related' : 'More from the Lab')}</p>
        <div class="related-grid">
          {displayRelated.map(p => (
            <a href={p.url} class="related-card">
              <div class="related-card-tags">
                {p.tags.slice(0, 2).map(t => <span class="tag">{t}</span>)}
              </div>
              <h3 class="related-card-title" style={isJa ? 'font-family: var(--font-jp)' : ''}>{p.title}</h3>
              {p.readTime && (
                <span class="related-card-meta">{p.readTime}{isJa ? ' 分' : ' min'}</span>
              )}
            </a>
          ))}
        </div>
        <div class="related-all-link">
          <a href={isJa ? '/ja/posts' : '/posts'}>{isJa ? 'すべての記事 →' : 'All articles →'}</a>
        </div>
      </section>
    )}

    <!-- Research-contextual product (renders nothing if no topical match) -->
    {matchedProduct && <RelatedProduct product={matchedProduct} lang={lang as 'en' | 'ja'} />}
  </div>

  <!-- ADHD Reading Support Toolbar -->
  <div class="adhd-tb" id="adhd-tb" data-lang={lang} data-slug={currentSlug}>
    <button class="adhd-trigger" id="adhd-trigger" title={isJa ? '読書サポート' : 'Reading support'} aria-label={isJa ? '読書サポートを開く' : 'Open reading support'} aria-expanded="false" aria-controls="adhd-panel">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <circle cx="12" cy="12" r="9"/>
      </svg>
    </button>
    <div class="adhd-panel" id="adhd-panel" role="dialog" aria-modal="false" hidden>
      <div class="adhd-panel-hd">
        <span class="adhd-panel-title">{isJa ? '読書サポート' : 'Reading support'}</span>
        <button class="adhd-close" id="adhd-close" aria-label={isJa ? '閉じる' : 'Close'}>✕</button>
      </div>
      <div class="adhd-row adhd-section-row">
        <span class="adhd-muted">{isJa ? 'セクション' : 'Section'}</span>
        <span id="adhd-section-val" class="adhd-mono">—</span>
      </div>
      <button class="adhd-btn adhd-btn--toggle" id="adhd-focus-btn" aria-pressed="false">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="9"/></svg>
        {isJa ? 'フォーカスモード' : 'Focus mode'}
      </button>
      <div class="adhd-font-group">
        <span class="adhd-muted adhd-font-label">{isJa ? '文字サイズ' : 'Font size'}</span>
        <div class="adhd-font-btns">
          <button class="adhd-font-btn" data-size="normal" aria-label={isJa ? '標準' : 'Normal'} style="font-size:0.78rem">A</button>
          <button class="adhd-font-btn" data-size="large" aria-label={isJa ? '大' : 'Large'} style="font-size:0.96rem">A</button>
          <button class="adhd-font-btn" data-size="xl" aria-label={isJa ? '特大' : 'X-Large'} style="font-size:1.12rem">A</button>
        </div>
      </div>
      <button class="adhd-btn" id="adhd-bookmark-btn">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        <span id="adhd-bookmark-label">{isJa ? 'しおりを挟む' : 'Bookmark here'}</span>
      </button>
      <div class="adhd-resume" id="adhd-resume" hidden>
        <span id="adhd-resume-text" class="adhd-muted">{isJa ? '前回の続き' : 'Resume reading'}</span>
        <button id="adhd-resume-go" class="adhd-resume-btn">{isJa ? '再開 →' : 'Go →'}</button>
      </div>
    </div>
  </div>

  <!-- Sticky TL;DR pill -->
  {tldr.length > 0 && (
    <div class="adhd-tldr-pip" id="adhd-tldr-pip" hidden>
      <button class="adhd-tldr-hd" id="adhd-tldr-hd" aria-expanded="false">
        <span>{isJa ? 'ポイント' : 'Key points'}</span>
        <span class="adhd-tldr-ct">({tldr.length})</span>
        <span class="adhd-tldr-chv" aria-hidden="true">▾</span>
      </button>
      <!-- Populated by JS from the visible .tldr-list (no duplicate static text) -->
      <ul class="adhd-tldr-ul" id="adhd-tldr-ul" hidden></ul>
    </div>
  )}

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />

  <!-- FAQPage JSON-LD (conditional — add faqItems: [{q, a}] to article frontmatter) -->
  {faqLD && <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />}

  <!-- Speakable JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org/',
    '@type': 'WebPage',
    name: frontmatter.title,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.article-header h1', '.tldr-list'],
    },
    url: canonicalURL.toString(),
  })} />
</BaseLayout>

<script>
(function () {
  // Reading progress
  const bar = document.getElementById('reading-progress') as HTMLElement | null;
  const articleBody = document.getElementById('article-body') as HTMLElement | null;
  if (bar && articleBody) {
    function updateProgress() {
      const rect = articleBody!.getBoundingClientRect();
      const pct = Math.min(100, Math.max(0, (-rect.top / articleBody!.offsetHeight) * 100));
      bar!.style.width = pct + '%';
      bar!.setAttribute('aria-valuenow', String(Math.round(pct)));
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  // Table of Contents
  const tocEl = document.getElementById('toc') as HTMLElement | null;
  const tocList = document.getElementById('toc-list');
  const body = document.getElementById('article-body');
  if (tocEl && tocList && body) {
    const headings = Array.from(body.querySelectorAll('h2, h3')) as HTMLElement[];
    if (headings.length >= 2) {
      headings.forEach((h, i) => {
        if (!h.id) {
          const slug = (h.textContent ?? '')
            .toLowerCase()
            .replace(/[^\w\s぀-ヿ一-鿿-]/g, '')
            .replace(/\s+/g, '-')
            .slice(0, 40);
          h.id = 'h-' + i + '-' + slug;
        }
        const li = document.createElement('li');
        li.className = h.tagName === 'H3' ? 'toc-item toc-item--sub' : 'toc-item';
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        li.appendChild(a);
        tocList.appendChild(li);
      });
      tocEl.style.display = '';

      // Scroll spy
      const links = tocList.querySelectorAll('a');
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              links.forEach(l => l.classList.remove('toc-link--active'));
              const active = tocList.querySelector(`a[href="#${entry.target.id}"]`);
              if (active) active.classList.add('toc-link--active');
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );
      headings.forEach(h => observer.observe(h));

      // Heading anchor links
      headings.forEach(h => {
        const anchor = document.createElement('a');
        anchor.href = '#' + h.id;
        anchor.className = 'heading-anchor';
        anchor.setAttribute('aria-label', 'Link to this section');
        anchor.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
        h.appendChild(anchor);
      });
    }
  }

  // ── ADHD Reading Support ──────────────────────────────────────────
  (function () {
    const tb = document.getElementById('adhd-tb') as HTMLElement | null;
    if (!tb) return;

    const slug = tb.dataset.slug ?? 'article';
    const lang = tb.dataset.lang ?? 'en';
    const isJa = lang === 'ja';
    const LS = (k: string) => `dlv_adhd_${slug}_${k}`;

    // Panel toggle
    const trigger = document.getElementById('adhd-trigger') as HTMLButtonElement | null;
    const panel   = document.getElementById('adhd-panel')  as HTMLElement | null;
    const closeBtn = document.getElementById('adhd-close') as HTMLButtonElement | null;

    function openPanel()  { if (!panel || !trigger) return; panel.hidden = false; trigger.setAttribute('aria-expanded', 'true');  trigger.classList.add('adhd-trigger--open'); }
    function closePanel() { if (!panel || !trigger) return; panel.hidden = true;  trigger.setAttribute('aria-expanded', 'false'); trigger.classList.remove('adhd-trigger--open'); }

    trigger?.addEventListener('click', (e) => { e.stopPropagation(); panel?.hidden ? openPanel() : closePanel(); });
    closeBtn?.addEventListener('click', closePanel);
    document.addEventListener('click', (e) => { if (!tb.contains(e.target as Node)) closePanel(); });

    // Section counter
    const sectionVal = document.getElementById('adhd-section-val');
    const artBody = document.getElementById('article-body') as HTMLElement | null;
    const h2s = artBody ? Array.from(artBody.querySelectorAll('h2')) as HTMLElement[] : [];

    if (sectionVal && h2s.length > 0) {
      sectionVal.textContent = `0 / ${h2s.length}`;
      const secObs = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const idx = h2s.indexOf(e.target as HTMLElement) + 1;
            sectionVal.textContent = `${idx} / ${h2s.length}`;
          }
        });
      }, { rootMargin: '-10% 0px -80% 0px' });
      h2s.forEach(h => secObs.observe(h));
    }

    // Focus mode
    const focusBtn = document.getElementById('adhd-focus-btn') as HTMLButtonElement | null;
    let focusActive = false;

    focusBtn?.addEventListener('click', () => {
      focusActive = !focusActive;
      document.body.classList.toggle('adhd-focus-active', focusActive);
      focusBtn.setAttribute('aria-pressed', String(focusActive));
      focusBtn.classList.toggle('adhd-btn--on', focusActive);
    });

    artBody?.addEventListener('click', (e) => {
      if (!focusActive) return;
      const para = (e.target as HTMLElement).closest('#article-body > p') as HTMLElement | null;
      if (para) para.classList.toggle('adhd-pinned');
    });

    // Font size
    const fontBtns = Array.from(document.querySelectorAll('.adhd-font-btn')) as HTMLButtonElement[];

    function applyFont(size: string) {
      document.body.classList.remove('adhd-font-large', 'adhd-font-xl');
      if (size === 'large') document.body.classList.add('adhd-font-large');
      else if (size === 'xl') document.body.classList.add('adhd-font-xl');
      fontBtns.forEach(b => b.classList.toggle('adhd-font-btn--on', b.dataset.size === size));
      try { localStorage.setItem(LS('font'), size); } catch { /* noop */ }
    }

    fontBtns.forEach(b => b.addEventListener('click', () => applyFont(b.dataset.size ?? 'normal')));

    try {
      const saved = localStorage.getItem(LS('font'));
      if (saved) applyFont(saved);
      else fontBtns[0]?.classList.add('adhd-font-btn--on');
    } catch {
      fontBtns[0]?.classList.add('adhd-font-btn--on');
    }

    // Bookmark
    const bookmarkBtn    = document.getElementById('adhd-bookmark-btn')  as HTMLButtonElement | null;
    const bookmarkLabel  = document.getElementById('adhd-bookmark-label');
    const resumeDiv      = document.getElementById('adhd-resume')        as HTMLElement | null;
    const resumeGo       = document.getElementById('adhd-resume-go')     as HTMLButtonElement | null;
    const resumeText     = document.getElementById('adhd-resume-text');

    function loadBookmark() {
      try {
        const raw = localStorage.getItem(LS('bm'));
        if (!raw || !resumeDiv || !resumeText) return;
        const bm = JSON.parse(raw) as { scrollY: number; section: string };
        resumeDiv.hidden = false;
        resumeText.textContent = bm.section || (isJa ? '前回の続き' : 'Resume reading');
      } catch { /* noop */ }
    }

    bookmarkBtn?.addEventListener('click', () => {
      const section = h2s.reduce<string>((acc, h) => h.getBoundingClientRect().top <= 80 ? (h.textContent ?? '') : acc, '');
      try { localStorage.setItem(LS('bm'), JSON.stringify({ scrollY: window.scrollY, section })); } catch { /* noop */ }
      if (bookmarkLabel) { bookmarkLabel.textContent = isJa ? '保存済み ✓' : 'Saved ✓'; }
      setTimeout(() => { if (bookmarkLabel) bookmarkLabel.textContent = isJa ? 'しおりを挟む' : 'Bookmark here'; }, 1500);
      loadBookmark();
    });

    resumeGo?.addEventListener('click', () => {
      try {
        const raw = localStorage.getItem(LS('bm'));
        if (!raw) return;
        const bm = JSON.parse(raw) as { scrollY: number };
        window.scrollTo({ top: bm.scrollY, behavior: 'smooth' });
      } catch { /* noop */ }
      closePanel();
    });

    loadBookmark();

    // Sticky TL;DR pill
    const pip    = document.getElementById('adhd-tldr-pip') as HTMLElement | null;
    const tldrBox = document.querySelector('.tldr-box')     as HTMLElement | null;
    const pipHd  = document.getElementById('adhd-tldr-hd') as HTMLButtonElement | null;
    const pipUl  = document.getElementById('adhd-tldr-ul') as HTMLElement | null;
    const pipChv = document.querySelector('.adhd-tldr-chv') as HTMLElement | null;

    if (pip && tldrBox) {
      if (pipUl && pipUl.children.length === 0) {
        tldrBox.querySelectorAll('.tldr-item').forEach(item => {
          const li = document.createElement('li');
          li.textContent = item.textContent;
          pipUl.appendChild(li);
        });
      }
      const pipObs = new IntersectionObserver(entries => {
        entries.forEach(e => { pip.hidden = e.isIntersecting; });
      }, { threshold: 0.5 });
      pipObs.observe(tldrBox);
    }

    pipHd?.addEventListener('click', () => {
      if (!pipUl) return;
      const nowHidden = !pipUl.hidden;
      pipUl.hidden = nowHidden;
      pipHd.setAttribute('aria-expanded', String(!nowHidden));
      if (pipChv) pipChv.textContent = nowHidden ? '▾' : '▴';
    });
  })();

})();
</script>

