---
// Shared Web Audio engine for the Sound Lab (JA + EN pages).
// No audio files, no libraries — pink/brown/white noise and binaural beats are
// synthesized entirely client-side. All user-visible text stays in the page
// markup; this script only reads element state (data-* attrs, classes) so it
// is language-agnostic and safe to import unchanged from both language pages.
---

<script is:inline>
(function () {
  var STORAGE_KEY = 'dlt_sound_prefs';
  var CARRIER_HZ = 200;
  var NOISE_BUFFER_SECONDS = 4;
  var FADE_SWITCH_SECONDS = 0.8;
  var FADE_IN_SECONDS = 1.5;
  var TIMER_FADE_SECONDS = 60;

  var PRESETS = {
    pink:  { kind: 'noise', noise: 'pink' },
    brown: { kind: 'noise', noise: 'brown' },
    white: { kind: 'noise', noise: 'white' },
    deep:  { kind: 'binaural', beat: 2 },
    relax: { kind: 'binaural', beat: 6 },
    focus: { kind: 'binaural', beat: 10 },
    gamma: { kind: 'binaural', beat: 40 },
  };

  var volumeSlider = document.getElementById('sound-volume');
  var timerBtns = document.querySelectorAll('.sound-timer-btn');
  var timerStatus = document.getElementById('sound-timer-status');
  var cards = document.querySelectorAll('.sound-card');

  if (!volumeSlider || !cards.length) return;
  // No Web Audio support → leave the cards inert instead of throwing on click.
  if (!window.AudioContext && !window.webkitAudioContext) return;

  var audioCtx = null;
  var masterGain = null;
  var currentSource = null;
  var currentPreset = null;
  var startTime = null;
  var switchTimeout = null;
  var timerTimeout = null;
  var timerFadeTimeout = null;

  function ga(event, params) {
    if (typeof window.gtag === 'function') window.gtag('event', event, params || {});
  }

  function ensureContext() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = Math.max(Number(volumeSlider.value) / 100, 0.0001);
      masterGain.connect(audioCtx.destination);
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function makeNoiseBuffer(ctx, kind) {
    var bufferSize = Math.floor(ctx.sampleRate * NOISE_BUFFER_SECONDS);
    var buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    var data = buffer.getChannelData(0);
    var i, white;
    if (kind === 'white') {
      for (i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
    } else if (kind === 'pink') {
      // Paul Kellet's refined pink noise approximation (public domain algorithm)
      var b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
      for (i = 0; i < bufferSize; i++) {
        white = Math.random() * 2 - 1;
        b0 = 0.99886 * b0 + white * 0.0555179;
        b1 = 0.99332 * b1 + white * 0.0750759;
        b2 = 0.96900 * b2 + white * 0.1538520;
        b3 = 0.86650 * b3 + white * 0.3104856;
        b4 = 0.55000 * b4 + white * 0.5329522;
        b5 = -0.7616 * b5 - white * 0.0168980;
        var pink = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;
        b6 = white * 0.115926;
        data[i] = pink * 0.11;
      }
    } else if (kind === 'brown') {
      var lastOut = 0;
      for (i = 0; i < bufferSize; i++) {
        white = Math.random() * 2 - 1;
        lastOut = (lastOut + 0.02 * white) / 1.02;
        data[i] = lastOut * 3.5;
      }
    }
    return buffer;
  }

  function startNoise(kind) {
    var ctx = ensureContext();
    var src = ctx.createBufferSource();
    src.buffer = makeNoiseBuffer(ctx, kind);
    src.loop = true;
    src.connect(masterGain);
    src.start();
    return {
      stop: function () {
        try { src.stop(); } catch (e) { /* already stopped */ }
        src.disconnect();
      },
    };
  }

  function startBinaural(beatHz) {
    var ctx = ensureContext();
    var oscL = ctx.createOscillator();
    var oscR = ctx.createOscillator();
    var panL = ctx.createStereoPanner();
    var panR = ctx.createStereoPanner();
    oscL.type = 'sine';
    oscR.type = 'sine';
    oscL.frequency.value = CARRIER_HZ;
    oscR.frequency.value = CARRIER_HZ + beatHz;
    panL.pan.value = -1;
    panR.pan.value = 1;
    oscL.connect(panL).connect(masterGain);
    oscR.connect(panR).connect(masterGain);
    oscL.start();
    oscR.start();
    return {
      stop: function () {
        try { oscL.stop(); oscR.stop(); } catch (e) { /* already stopped */ }
        oscL.disconnect(); oscR.disconnect(); panL.disconnect(); panR.disconnect();
      },
    };
  }

  function fadeOutAndStop(source, seconds, done) {
    var ctx = ensureContext();
    var now = ctx.currentTime;
    masterGain.gain.cancelScheduledValues(now);
    masterGain.gain.setValueAtTime(masterGain.gain.value, now);
    masterGain.gain.linearRampToValueAtTime(0.0001, now + seconds);
    setTimeout(function () {
      source.stop();
      if (done) done();
    }, seconds * 1000 + 60);
  }

  function fadeIn(seconds) {
    var ctx = ensureContext();
    var now = ctx.currentTime;
    var target = Math.max(Number(volumeSlider.value) / 100, 0.0001);
    masterGain.gain.cancelScheduledValues(now);
    masterGain.gain.setValueAtTime(0.0001, now);
    masterGain.gain.linearRampToValueAtTime(target, now + seconds);
  }

  function setActiveCard(id) {
    cards.forEach(function (card) {
      var isActive = card.dataset.preset === id;
      card.classList.toggle('sound-card--playing', isActive);
      var btn = card.querySelector('.sound-card-play');
      if (btn) btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  function elapsedSeconds() {
    return startTime ? Math.round((Date.now() - startTime) / 1000) : 0;
  }

  function savePrefs() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        preset: currentPreset,
        volume: Number(volumeSlider.value),
      }));
    } catch (e) { /* storage unavailable */ }
  }

  function loadPrefs() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      var prefs = JSON.parse(raw);
      if (prefs && typeof prefs.volume === 'number') volumeSlider.value = String(prefs.volume);
    } catch (e) { /* storage unavailable or malformed */ }
  }

  function startPresetNow(id) {
    var def = PRESETS[id];
    if (!def) return;
    currentSource = def.kind === 'noise' ? startNoise(def.noise) : startBinaural(def.beat);
    currentPreset = id;
    startTime = Date.now();
    fadeIn(FADE_IN_SECONDS);
    setActiveCard(id);
    ga('sound_play', { preset: id });
    savePrefs();
  }

  function stopPresetNow() {
    if (!currentSource) return;
    var id = currentPreset;
    var src = currentSource;
    ga('sound_stop', { preset: id, seconds: elapsedSeconds() });
    fadeOutAndStop(src, FADE_SWITCH_SECONDS, function () {});
    currentSource = null;
    currentPreset = null;
    startTime = null;
    setActiveCard(null);
    clearSleepTimer();
  }

  function togglePreset(id) {
    ensureContext();
    clearTimeout(switchTimeout);

    if (currentPreset === id) {
      stopPresetNow();
      return;
    }
    if (currentSource) {
      var oldSrc = currentSource;
      ga('sound_stop', { preset: currentPreset, seconds: elapsedSeconds() });
      fadeOutAndStop(oldSrc, FADE_SWITCH_SECONDS, function () {});
      currentSource = null;
      currentPreset = null;
      switchTimeout = setTimeout(function () { startPresetNow(id); }, FADE_SWITCH_SECONDS * 1000 + 100);
    } else {
      startPresetNow(id);
    }
  }

  function clearSleepTimer() {
    clearTimeout(timerTimeout);
    clearTimeout(timerFadeTimeout);
    timerTimeout = null;
    timerFadeTimeout = null;
    if (timerStatus) { timerStatus.hidden = true; timerStatus.textContent = ''; }
    timerBtns.forEach(function (b) { b.classList.remove('sound-timer-btn--active'); });
  }

  function setSleepTimer(minutes, btn) {
    clearSleepTimer();
    if (!minutes) return;
    var totalMs = minutes * 60 * 1000;
    var fadeStartMs = Math.max(totalMs - TIMER_FADE_SECONDS * 1000, 0);
    btn.classList.add('sound-timer-btn--active');
    if (timerStatus) {
      var template = timerStatus.dataset.template || '{n}';
      timerStatus.hidden = false;
      timerStatus.textContent = template.replace('{n}', String(minutes));
    }
    timerFadeTimeout = setTimeout(function () {
      if (currentSource) fadeOutAndStop(currentSource, TIMER_FADE_SECONDS, function () {});
    }, fadeStartMs);
    timerTimeout = setTimeout(function () {
      currentSource = null;
      currentPreset = null;
      startTime = null;
      setActiveCard(null);
      clearSleepTimer();
    }, totalMs);
    ga('timer_set', { minutes: minutes });
  }

  cards.forEach(function (card) {
    var id = card.dataset.preset;
    var btn = card.querySelector('.sound-card-play');
    if (btn) btn.addEventListener('click', function () { togglePreset(id); });
  });

  timerBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var min = parseInt(btn.dataset.min, 10);
      if (!min) { clearSleepTimer(); return; }
      setSleepTimer(min, btn);
    });
  });

  volumeSlider.addEventListener('input', function () {
    savePrefs();
    if (!audioCtx || !masterGain) return;
    var now = audioCtx.currentTime;
    var vol = Math.max(Number(volumeSlider.value) / 100, 0.0001);
    masterGain.gain.cancelScheduledValues(now);
    masterGain.gain.setTargetAtTime(vol, now, 0.05);
  });

  document.addEventListener('astro:before-swap', function () {
    clearSleepTimer();
    if (currentSource) { try { currentSource.stop(); } catch (e) { /* noop */ } }
    currentSource = null;
    currentPreset = null;
    if (audioCtx) { try { audioCtx.close(); } catch (e) { /* noop */ } }
    audioCtx = null;
    masterGain = null;
  });

  loadPrefs();
})();
</script>
